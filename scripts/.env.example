# scripts/.env.example
#
# DO NOT edit this file directly. Copy to scripts/.env and populate it.
#
# RECOMMENDED: Run scripts/fetch-ssm-env.sh to auto-populate scripts/.env from
# AWS SSM Parameter Store (requires AWS CLI + IAM role on the EC2 instance).
#
# SSM paths (written by Terraform Lambda DB init in Github-Repo-AWS-SharedServices-Infra):
#   /{SSM_ENV}/{SSM_APP}/db/uri         -> DATABASE_URI
#   /{SSM_ENV}/{SSM_APP}/payload/secret -> PAYLOAD_SECRET
#
# To fetch automatically (run on the EC2 instance):
#   export SSM_ENV=nonprod SSM_APP=testapp AWS_REGION=us-east-1
#   ./scripts/fetch-ssm-env.sh

# --- RDS credentials (fetched from SSM by fetch-ssm-env.sh) ---
# Full postgresql:// URI for the shared RDS instance (app database and user).
DATABASE_URI=postgresql://testapp_user:<password>@<rds-endpoint>:5432/testapp_db

# Payload CMS secret key (min 32 chars). Generated once by Terraform and stored in SSM.
PAYLOAD_SECRET=<fetch-from-ssm>

# --- Backend runtime ---
PAYLOAD_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# --- Frontend ---
# Baked into the frontend image at build time (browser uses this to call backend API).
NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3001
# Server-side API URL (container -> backend). Use hostname "backend" in Docker.
PAYLOAD_API_URL=http://backend:3001
