# PostgreSQL (used by backend)
POSTGRES_USER=payload
POSTGRES_PASSWORD=changeme
POSTGRES_DB=payload_db

# Backend (Payload CMS) - DATABASE_URI must use hostname "postgres" in compose
DATABASE_URI=postgresql://payload:changeme@postgres:5432/payload_db
PAYLOAD_SECRET=your-secret-key-min-32-chars
PAYLOAD_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Frontend (Next.js) - build-time only; browser uses this to call backend API
NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3001
# Server-side API URL (container -> backend). Use hostname "backend" in Docker.
PAYLOAD_API_URL=http://backend:3001
